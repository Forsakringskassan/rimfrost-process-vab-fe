VITE_APP_PORT=3043
VITE_APP_PORT_DEV=3042
# Gäller bygget som portalen laddar (npm run build/serve). BFF:en tillåter anrop från portalen på 3030.
# Vid npm run dev skriver .env.development över med tomt värde, så att anropen går via Vite-proxyn.
VITE_BFF_URL=http://localhost:9006

# For local development, set ids instead of passing them from the portal.
# VITE_DEV_AKTIVITET_ID must be an aktivitetId from vab.bpmn's process description.
VITE_DEV_HANDLAGGNING_ID=00be1ee0-5ffd-4394-bec2-4634770d9351
VITE_DEV_AKTIVITET_ID=c58dd666-b3c1-4a30-91b8-76c3495668c6
